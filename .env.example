# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
# OpenAI-compatible endpoint that actually serves a vision-capable Gemma model.
# Verify provider model ID, image format, and quota before use.
